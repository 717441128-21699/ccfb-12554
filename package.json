{
  "name": "commercial-light-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "node --experimental-strip-types tests/verify.ts",
    "gen:samples": "node --experimental-strip-types tests/genSamples.ts",
    "smoke": "vite preview --port 4173 & sleep 3 && node tests/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "jspdf": "^2.5.2"
  }
}
